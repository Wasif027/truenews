# Postgres (pgvector-enabled). docker-compose provides this locally.
DATABASE_URL=postgresql+psycopg://truenews:truenews@localhost:5432/truenews

# Countries to ingest and serve, comma-separated (see app/ingest/sources.py).
# The first is the default shown before the user picks one. More countries =
# longer ingest and more DB compute; trim on a tight free tier.
COUNTRIES=bd,in,pk,ng,ph,uk,us,au,ie,sg,my,ca,nz,za,ke,gh,ug,zw,jp,lk,np,jm

# Rolling window (hours) considered when (re)clustering each run
CLUSTER_WINDOW_HOURS=72
# Cosine-similarity threshold for linking two articles into the same story
# (bge-small-en-v1.5 headline embeddings). 0.80 tuned on real BD feeds;
# lower merges more aggressively, higher splits stories apart.
CLUSTER_SIM_THRESHOLD=0.80

# LLM for the summary + coverage comparison. Up to 3 OpenAI-compatible providers,
# tried in order; a slot activates once its _KEY is set, _MODEL may be a
# comma-separated list. With none set, the offline heuristic is used (no account).
# Chaining free tiers keeps the feature covered without paying:
#   Gemini  aistudio.google.com/apikey  gemini-3.5-flash (generous) / *-pro-latest (best, low limit)
#   Groq    console.groq.com            gpt-oss-120b etc. (fast, ~200k tokens/day/model)
LLM_1_KEY=
LLM_1_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_1_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
LLM_2_KEY=
LLM_2_BASE=https://api.groq.com/openai/v1
LLM_2_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Optional third provider — any OpenAI-compatible endpoint (OpenRouter free tier,
# Together, a paid Cerebras/Groq account, ...). Inactive until all three are set.
LLM_3_KEY=
LLM_3_BASE=
LLM_3_MODEL=

# Max clusters given the full model comparison per run per country. The rest of
# the window still gets the offline summary + one-line comparison.
SUMMARY_BUDGET_PER_RUN=40

# CORS origin for the frontend
FRONTEND_ORIGIN=http://localhost:3000

# Auth. The default below is fine for local dev. For anything deployed, set a
# real secret:  python -c "import secrets; print(secrets.token_hex(32))"
# and set COOKIE_SECURE=true once the site is served over https.
SECRET_KEY=dev-insecure-secret-change-me-before-you-deploy-anything
TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Run ingestion inside the API process every N minutes (0 = off).
# Set to e.g. 10 for local dev so new stories appear on their own while you
# watch. Leave at 0 for the deployed version and use the GitHub Actions cron,
# so ingestion doesn't run twice against the same database.
INGEST_INTERVAL_MIN=0
